# 本機開發環境變數範本：cp .dev.vars.example .dev.vars 後填入真實值
# 注意：wrangler.jsonc 的 [vars] 只放「非機密」預設值；
#       機密（API 金鑰、ADMIN_SECRET）請用 `wrangler secret put`。

# LLM（OpenAI 相容端點）
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# API key 認證（留空 = 關掉 /v1 認證，僅限開發）
API_KEY_HEADER=x-api-key
ALLOW_QUERY_TOKEN=false
ALLOW_BEARER_TOKEN=false

# 管理端點（POST /v1/admin/keys 等）
ADMIN_SECRET=

# 選用：Cloudflare Access（保護 /agents/* 的瀏覽器流量）
CF_ACCESS_JWT_AUD=

# 限流
RATE_LIMIT_RPM=60
RATE_LIMIT_IP_RPM=20

# 其他
ENVIRONMENT=development
LOG_LEVEL=info
ALLOWED_ORIGINS=*
